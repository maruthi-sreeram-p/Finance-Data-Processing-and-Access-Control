# ---------------------------------------------------------------------------
# FinTrack environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored and is loaded automatically by Spring Boot via
# `spring.config.import` in application.yml, and by Docker Compose.
# NEVER commit a populated .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Running the app directly against a MySQL on your machine:
DB_URL=jdbc:mysql://localhost:3306/fintrack?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=fintrack
DB_PASSWORD=change-me

# --- JWT ------------------------------------------------------------------
# Must be Base64 and decode to at least 32 bytes (256 bits) for HS256.
# The application refuses to start otherwise, rather than failing at first login.
# Generate one with:
#   openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-encoded-256-bit-secret
JWT_EXPIRATION_MS=3600000

# --- Application ----------------------------------------------------------
SERVER_PORT=8080
LOG_LEVEL_APP=INFO

# --- Docker Compose only --------------------------------------------------
# Ignored when running the app directly; used by docker-compose.yml.
# DB_URL above is overridden there to point at the `mysql` service.
MYSQL_DATABASE=fintrack
MYSQL_ROOT_PASSWORD=change-me-too
# Published host ports. 3307 avoids clashing with a MySQL already on 3306.
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8080
