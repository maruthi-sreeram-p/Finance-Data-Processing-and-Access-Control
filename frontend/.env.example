# ---------------------------------------------------------------------------
# FinTrack frontend environment template
#
#   cp .env.example .env
#
# Only VITE_-prefixed variables reach the browser bundle -- that prefix is Vite's
# safeguard against a server secret being inlined into shipped JavaScript by
# accident. Never put a secret here: everything in this file is publicly readable
# once the app is built.
# ---------------------------------------------------------------------------

# Base URL of the FinTrack API, including the /api prefix.
# Must match an origin the backend allows through CORS (CORS_ALLOWED_ORIGINS).
VITE_API_BASE_URL=http://localhost:8080/api
